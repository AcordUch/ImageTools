<CroppingWidget>:
    orientation: 'vertical'
    BoxLayout: # Часть с изображением и выбором цвета
        orientation: 'horizontal'
        size_hint: (1, .8)
        Image: # Часть с изображением
            canvas.before:
                Color:
                    rgba: root.bg_color
                Rectangle:
                    pos: self.pos
                    size: self.size

            orientation: 'vertical'
            id: image_display
            texture: root.image_texture_property
        BoxLayout: # Часть с выбором цвета
            orientation: 'vertical'
            size_hint: (.07, 1)
            Button: # Красный
                size_hint: (1, .33)
                text: 'Red'
                on_release: print(image_display.source) #todo: remove
            Button: # Черный
                size_hint: (1, .33)
                text: 'Black'
                on_release: root.change_background()
            Button: # Белый
                size_hint: (1, .33)
                text: 'White'
            BoxLayout: # Stub
                size_hint: (1, .5)
    StackLayout: # Часть с управлением рамки по горизонтали
        orientation: 'lr-tb'
        size_hint: (1, .1)
        Button:
            size_hint: (.25, 1)
            text: '<-'
            on_press: root._start_repeating(-10, root.move_x)
            on_release: root._stop_repeating(root.move_x)
        Button:
            size_hint: (.25, 1)
            text: '->'
            on_press: root._start_repeating(10, root.move_x)
            on_release: root._stop_repeating(root.move_x)
        Button:
            size_hint: (.25, 1)
            text: 'expand'
            on_press: root._start_repeating(5, root.resize_width)
            on_release: root._stop_repeating(root.resize_width)
        Button:
            size_hint: (.25, 1)
            text: 'compress'
            on_press: root._start_repeating(-5, root.resize_width)
            on_release: root._stop_repeating(root.resize_width)
    StackLayout: # Часть с управлением рамки по вертикале
        orientation: 'lr-tb'
        size_hint: (1, .1)
        Button:
            size_hint: (.25, 1)
            text: 'up'
            on_press: root._start_repeating(-10, root.move_y)
            on_release: root._stop_repeating(root.move_y)
        Button:
            size_hint: (.25, 1)
            text: 'down'
            on_press: root._start_repeating(10, root.move_y)
            on_release: root._stop_repeating(root.move_y)
        Button:
            size_hint: (.25, 1)
            text: 'expand'
            on_press: root._start_repeating(5, root.resize_height)
            on_release: root._stop_repeating(root.resize_height)
        Button:
            size_hint: (.25, 1)
            text: 'compress'
            on_press: root._start_repeating(-5, root.resize_height)
            on_release: root._stop_repeating(root.resize_height)
