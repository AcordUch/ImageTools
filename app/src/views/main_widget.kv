#:import CroppingWidget app.src.views.cropping_widget.CroppingWidget
#:import CropSettingsWidget app.src.views.crop_settings_widget.CropSettingsWidget
#:import IOWidget app.src.views.io_widget.IOWidget

<MainWidget>:
    orientation: 'vertical'
    BoxLayout: # main
        orientation: 'horizontal'
        BoxLayout: # Левая часть
            orientation: 'vertical'
            size_hint: (.2, 1)
            IOWidget: # Часть с IO изображения
                size_hint: (1, .2)
                cropping_widget: cropping_widget
            CropSettingsWidget: # Часть с настройкой разделения
                size_hint: (1, .5)
                cropping_widget: cropping_widget
            BoxLayout: # Stub
                size_hint: (1, .4)
        CroppingWidget: # Правая часть
            size_hint: (.8, 1)
            id: cropping_widget
