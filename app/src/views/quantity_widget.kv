<QuantityWidget>:
    orientation: 'horizontal'
    Label:
        size_hint: (.7, 1)
        id: quantity_input_box
        halign: 'center'
        font_size: '25sp'
        text: root.quantity_input
    BoxLayout:
        orientation: 'vertical'
        size_hint: (.3, 1)
        Button:
            size_hint: (1, .5)
            text: '+'
            on_release: root.increase()
        Button:
            size_hint: (1, .5)
            text: '-'
            on_release: root.decrease()