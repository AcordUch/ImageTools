<QuantityWidget>:
    orientation: 'horizontal'
    TextInput:
        size_hint: (.7, 1)
        id: quantity_input_box
        multiline: False
        halign: 'center'
        font_size: '25sp'
        text: root.quantity_input
        input_filter: "int"
        on_text: root.validate_input(self.text)
    BoxLayout:
        orientation: 'vertical'
        size_hint: (.3, 1)
        Button:
            size_hint: (1, .5)
            text: '+'
            on_release: root.increase()
        Button:
            size_hint: (1, .5)
            text: '-'
            on_release: root.decrease()